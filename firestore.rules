rules_version = '2';

// LA PLAGE · Firestore security rules
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
// ⚠ Put the same admin Gmail address(es) as in firebase-config.js into isAdmin() below, in lowercase.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'lookmanfc@gmail.com',
          'ryannguyen101209@gmail.com'
        ];
    }
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validGmail(g) {
      return g is string && g.size() <= 120 && g.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }
    function validAddress(a) {
      return a is map && a.keys().hasOnly(['street', 'ward', 'district', 'city'])
        && a.street is string && a.street.size() <= 120
        && a.ward is string && a.ward.size() <= 60
        && a.district is string && a.district.size() <= 60
        && a.city is string && a.city.size() <= 60;
    }

    // ---- customer accounts ----
    match /users/{uid} {
      // customers see only their own record; admins see everyone
      allow read: if isOwner(uid) || isAdmin();

      // created once at sign-up, by the customer, never already disabled
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'name', 'gmail', 'phone', 'address', 'disabled', 'createdAt', 'lastLogin'])
        && request.resource.data.uid == uid
        && request.resource.data.username is string && request.resource.data.username.matches('^[a-z0-9._]{3,20}$')
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && validGmail(request.resource.data.gmail)
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && validAddress(request.resource.data.address)
        && request.resource.data.disabled == false
        && request.resource.data.createdAt == request.time;

      // customers may edit their contact details only (never username, disabled or dates)
      allow update: if (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'gmail', 'phone', 'address', 'lastLogin'])
          && validGmail(request.resource.data.gmail)
          && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
          && validAddress(request.resource.data.address))
        // admins may disable or re-enable an account
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled'])
          && request.resource.data.disabled is bool);

      allow delete: if isAdmin();
    }

    // ---- pre-orders ----
    match /orders/{orderId} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();

      // a signed-in customer with an active (not disabled) account, ordering for themselves,
      // always starting as "awaiting payment", with free shipping (total = subtotal)
      // pre-orders open 20 November 2026, 00:00 Saigon time (= 17:00 UTC on the 19th); nothing can be placed before that
      allow create: if request.time >= timestamp.date(2026, 11, 19) + duration.time(17, 0, 0, 0)
        && signedIn()
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled == false
        && request.resource.data.keys().hasOnly(['uid', 'username', 'gmail', 'customerName', 'phone', 'address', 'note', 'items', 'subtotal', 'shippingFee', 'total', 'payment', 'status', 'createdAt'])
        && validGmail(request.resource.data.gmail)
        && request.resource.data.customerName is string && request.resource.data.customerName.size() > 0 && request.resource.data.customerName.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20
        && validAddress(request.resource.data.address)
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 10
        && request.resource.data.subtotal is int && request.resource.data.subtotal > 0
        && request.resource.data.shippingFee == 0
        && request.resource.data.total == request.resource.data.subtotal
        && request.resource.data.payment in ['bank', 'qr', 'cash']
        && request.resource.data.status == 'awaiting payment'
        && request.resource.data.createdAt == request.time;

      // only admins change a pre-order, and only its status and whether the money has been collected
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'paid', 'paidAt'])
        && (!('paid' in request.resource.data) || request.resource.data.paid is bool)
        && request.resource.data.status in ['awaiting payment', 'in process', 'packaging', 'shipped', 'delivered', 'cancelled'];

      allow delete: if isAdmin();
    }

    // ---- mailing list ----
    // Each subscriber is stored under a long random token (their private unsubscribe key).
    // Nobody can list or search subscribers except admins; anyone holding the token (from the
    // email's unsubscribe link) can read that one record and flip its status.
    match /subscribers/{token} {
      allow get: if token.matches('^[a-f0-9]{32,64}$') || isAdmin();
      allow list: if isAdmin();

      allow create: if token.matches('^[a-f0-9]{32,64}$')
        && request.resource.data.keys().hasOnly(['email', 'status', 'source', 'consent', 'createdAt', 'updatedAt'])
        && validGmail(request.resource.data.email)
        && request.resource.data.status == 'subscribed'
        && request.resource.data.consent == true
        && request.resource.data.source is string && request.resource.data.source.size() <= 30
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // unsubscribe (or re-subscribe): the status and its timestamp, nothing else
      allow update: if token.matches('^[a-f0-9]{32,64}$')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['subscribed', 'unsubscribed']
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // ---- contact messages ----
    // One document per conversation, stored under a long random token (the customer's private link to the thread).
    // Customers can create a conversation and append their own messages; only admins can list, answer, close or delete.
    match /messages/{token} {
      allow get: if token.matches('^[a-f0-9]{32,64}$') || isAdmin();
      allow list: if isAdmin();

      allow create: if token.matches('^[a-f0-9]{32,64}$')
        && request.resource.data.keys().hasOnly(['name', 'email', 'topic', 'status', 'thread', 'unreadAdmin', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && validGmail(request.resource.data.email)
        && request.resource.data.topic in ['general', 'unsubscribe', 'preorder', 'order', 'other']
        && request.resource.data.status == 'open'
        && request.resource.data.unreadAdmin == true
        && request.resource.data.thread is list && request.resource.data.thread.size() == 1
        && request.resource.data.thread[0].keys().hasOnly(['from', 'text', 'at'])
        && request.resource.data.thread[0].from == 'customer'
        && request.resource.data.thread[0].text is string && request.resource.data.thread[0].text.size() > 0 && request.resource.data.thread[0].text.size() <= 2000
        && request.resource.data.thread[0].at is number
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update:
        // the customer adds exactly one more message of their own, and nothing else changes
        if (token.matches('^[a-f0-9]{32,64}$')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thread', 'unreadAdmin', 'status', 'updatedAt'])
          && request.resource.data.thread.size() == resource.data.thread.size() + 1
          && request.resource.data.thread[0:resource.data.thread.size()] == resource.data.thread
          && request.resource.data.thread[resource.data.thread.size()].keys().hasOnly(['from', 'text', 'at'])
          && request.resource.data.thread[resource.data.thread.size()].from == 'customer'
          && request.resource.data.thread[resource.data.thread.size()].text is string
          && request.resource.data.thread[resource.data.thread.size()].text.size() > 0
          && request.resource.data.thread[resource.data.thread.size()].text.size() <= 2000
          && request.resource.data.thread[resource.data.thread.size()].at is number
          && request.resource.data.unreadAdmin == true
          && request.resource.data.status == 'open'
          && request.resource.data.updatedAt == request.time)
        // admins reply, mark as read, close or reopen
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thread', 'unreadAdmin', 'status', 'updatedAt'])
          && request.resource.data.status in ['open', 'closed']);

      allow delete: if isAdmin();
    }

    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
